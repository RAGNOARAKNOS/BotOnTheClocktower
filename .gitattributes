# Store text files with LF and check them out with LF on every platform,
# whatever the local core.autocrlf setting. gofmt, the Dockerfile and the
# Linux CI runners all expect LF.
* text=auto eol=lf

# Binary files: never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.exe  binary

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
